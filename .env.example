# =============================================================================
# RAG Institucional — variáveis de ambiente
# Copie para .env e ajuste. NUNCA versione o arquivo .env com credenciais reais.
# Os processos procuram o .env subindo a partir do diretório atual; RAG_ENV_FILE=/caminho/.env força outro arquivo.
# =============================================================================

NODE_ENV=development
LOG_LEVEL=info

# --- Banco de dados (PostgreSQL 17 + pgvector >= 0.8) ---
DATABASE_URL=postgres://rag:rag@127.0.0.1:54329/rag
DATABASE_POOL_MAX=10

# --- Redis (filas BullMQ) ---
REDIS_URL=redis://127.0.0.1:6379/5
QUEUE_PREFIX=rag

# --- API ---
# Sem autenticação institucional, mantenha a API restrita a localhost/rede interna confiável.
API_HOST=127.0.0.1
API_PORT=4000
API_BASE_URL=http://127.0.0.1:4000
WEB_ORIGIN=http://localhost:3000
# Token compartilhado entre o frontend (servidor Next.js) e a API. Gere com: openssl rand -hex 32
ADMIN_API_TOKEN=troque-este-token-por-um-valor-aleatorio-longo
# Credencial de acesso aplicada enquanto não houver autenticação: publico|interno|restrito|sigiloso
DEFAULT_ACCESS_CLEARANCE=interno
TRUST_PROXY=false

# --- Frontend (Next.js; lidas apenas no servidor, nunca expostas ao navegador) ---
# URL da API vista pelo servidor Next.js. Padrão: http://127.0.0.1:${API_PORT}
API_URL=http://127.0.0.1:4000
# Valores aceitos no cabeçalho Host (proteção contra DNS rebinding), separados por vírgula
WEB_ALLOWED_HOSTS=localhost:3000,127.0.0.1:3000
# Identidade que o frontend declara à API enquanto não houver login institucional.
# Sem estas variáveis, a API aplica o padrão (papel admin, credencial DEFAULT_ACCESS_CLEARANCE).
# Papéis: viewer, analyst, admin (separados por vírgula). Credencial: publico|interno|restrito|sigiloso
# WEB_USER_ID=usuario-local
# WEB_USER_NAME=Usuário local
# WEB_USER_ROLES=admin
# WEB_USER_CLEARANCE=interno

# --- Armazenamento de arquivos ---
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage
# Para S3/MinIO (STORAGE_DRIVER=s3):
# S3_ENDPOINT=http://127.0.0.1:9000
# S3_REGION=us-east-1
# S3_BUCKET=rag-documentos
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

UPLOAD_MAX_BYTES=52428800
UPLOAD_MAX_FILES=20

# --- Provedores de IA ---
# ollama (local, padrão) ou openai
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_NUM_CTX=8192
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
CHAT_MODEL=qwen2.5:7b
# Modelo leve para reescrita de consultas e reranking
UTILITY_MODEL=qwen2.5:3b
# Modelo usado como juiz nas avaliações automatizadas
JUDGE_MODEL=qwen2.5:7b
LLM_REQUEST_TIMEOUT_MS=180000

EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
EMBEDDING_BATCH_SIZE=32
EMBEDDING_MAX_RPM=600

# none | llm | http (endpoint compatível com /rerank estilo Cohere/Jina/TEI)
# Recomendado: cross-encoder local bge-reranker-v2-m3 servido pelo llama.cpp (brew install llama.cpp),
# ~1 s para 16 trechos contra ~18 s do rerank por LLM em Apple Silicon:
#   npm run reranker:download && npm run reranker:start   (escuta só em 127.0.0.1:8080)
# (GGUF: https://huggingface.co/gpustack/bge-reranker-v2-m3-GGUF). TEI também é compatível
# (RERANK_HTTP_SCORE_TYPE=probability), mas no backend Metal mediu-se 5–13 s para 16 trechos.
# RERANK_PROVIDER=http
# RERANK_MODEL=bge-reranker-v2-m3
# RERANK_HTTP_URL=http://127.0.0.1:8080/rerank
# RERANK_HTTP_SCORE_TYPE=logit
RERANK_PROVIDER=llm
RERANK_MODEL=qwen2.5:3b
# RERANK_HTTP_URL=
# RERANK_HTTP_API_KEY=
# auto | logit (llama.cpp devolve logits brutos) | probability (TEI, Cohere, Jina)
RERANK_HTTP_SCORE_TYPE=auto

# Cache de respostas (Redis), chaveado pela pergunta normalizada + contexto recuperado. 0 desativa.
ANSWER_CACHE_TTL_SECONDS=86400

# --- OCR ---
OCR_ENGINE=tesseract
TESSERACT_PATH=tesseract
PDFTOPPM_PATH=pdftoppm
OCR_LANGUAGES=por
OCR_DPI=300
OCR_TIMEOUT_MS=120000
# Diretório dos modelos de idioma do Tesseract, se não estiver no caminho padrão (ex.: tessdata_best)
# TESSDATA_PREFIX=/opt/homebrew/share/tessdata

# --- Worker ---
WORKER_CONCURRENCY=2
PROCESSING_TIMEOUT_MS=1800000

# --- Limites e consumo ---
# Orçamento diário de tokens (entrada + saída) para todas as operações de LLM. 0 = ilimitado.
DAILY_TOKEN_BUDGET=0
CHAT_RATE_LIMIT_PER_MINUTE=20
API_RATE_LIMIT_PER_MINUTE=300
MAX_QUESTION_CHARS=4000

# --- Observabilidade (opcional) ---
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=rag-institucional
